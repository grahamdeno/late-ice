# Supabase project (Settings > API). The anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Settings > Database > Connection pooling, transaction mode, port 6543)
DATABASE_URL=
# Scoresheet reader
ANTHROPIC_API_KEY=
# Protects the nightly rating recompute endpoint (Vercel Cron sends it)
CRON_SECRET=
