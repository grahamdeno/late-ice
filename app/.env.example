# Supabase project (Settings > API). The anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Settings > Database > Connection pooling, transaction mode, port 6543)
DATABASE_URL=
# Scoresheet reader
ANTHROPIC_API_KEY=
# Optional model list, primary then one fallback. Default: claude-sonnet-5-5,claude-opus-5-5
# LATE_ICE_OCR_MODELS=
# Site-wide scans per month. Default 2000. Players also have SCAN_DAILY_PER_USER (default 15).
# SCAN_MONTHLY_CAP=
# SCAN_DAILY_PER_USER=
# Set to 1 in tests to use the built-in fake reader. Never set this in production.
# LATEICE_FAKE_OCR=
# Protects the nightly rating recompute endpoint (Vercel Cron sends it)
CRON_SECRET=
